<UserControl x:Class="BearingFaultDiagnosis.Views.Pages.DeepDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BearingFaultDiagnosis.Views.Pages"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F6FA">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="深度诊断分析台" FontSize="22" FontWeight="Bold" Foreground="#333333" VerticalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="导出诊断报告" Padding="15,8" Margin="0,0,10,0" Background="#E0E5EC" BorderThickness="0"/>
                <Button Content="▶ 执行双分支联合诊断" Padding="15,8" Background="#00B894" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="■ 物理感知分支 (机理特征提取)" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" Margin="5,0,0,10"/>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="原始时域波形 vs 角域重采样波形" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="RawPlot" Margin="0,5,0,5" />
                        <ScottPlot:WpfPlot Grid.Row="2" x:Name="PurePlot" Margin="0,5,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="变工况阶次谱 (Order Spectrum)" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                        <TextBlock Text="[ 阶次谱图表占位：高亮显示特征阶次峰值 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B2BEC3"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="包络谱解调分析 (Envelope Spectrum)" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                        <TextBlock Text="[ 包络谱图表占位：展示解调后的故障频率 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B2BEC3"/>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="1.5*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="■ 域泛化网络分支 (AI驱动诊断)" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" Margin="5,0,0,10"/>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="CWT 连续小波时频热力图" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                        <TextBlock Text="[ 时频热力图占位：展示能量随频带和转速的变化 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B2BEC3"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <TextBlock Text="高维域泛化特征分布 (t-SNE/UMAP)" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                        <TextBlock Text="[ 散点图占位：展示变工况下网络特征聚类与对齐能力 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B2BEC3"/>
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="综合诊断结论" FontSize="14" Foreground="#636E72" HorizontalAlignment="Center"/>
                            <TextBlock Text="外圈早期损伤" FontSize="24" FontWeight="Bold" Foreground="#D63031" Margin="0,10,0,0" HorizontalAlignment="Center"/>
                            <TextBlock Text="建议增强润滑并持续关注" FontSize="12" Foreground="#D63031" Margin="0,5,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="双分支网络预测概率" FontSize="12" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                            <TextBlock Text="[ 条形图占位：显示各故障类型的 Softmax 概率 ]" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B2BEC3"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>