<UserControl x:Class="BearingFaultDiagnosis.Views.Pages.DeepDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BearingFaultDiagnosis.Views.Pages"
             xmlns:converters="clr-namespace:BearingFaultDiagnosis.Converters"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d" 
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F6FA">
    <UserControl.Resources>
        <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
    </UserControl.Resources>
    <Grid Margin="15">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- 全宽波形图 -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="原始时域波形 vs 角域重采样波形" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="RawPlot" Margin="0,5,0,5" />
                    <ScottPlot:WpfPlot Grid.Row="2" x:Name="PurePlot" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <Grid Margin="5,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="■ 物理感知分支 (机理特征提取)" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" Content="外圈 BPFO" IsChecked="{Binding ShowBPFO}" Foreground="#E74C3C" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <CheckBox Grid.Column="2" Content="内圈 BPFI" IsChecked="{Binding ShowBPFI}" Foreground="#3498DB" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <CheckBox Grid.Column="3" Content="滚动体 BSF"  IsChecked="{Binding ShowBSF}"  Foreground="#27AE60" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                    <CheckBox Grid.Column="4" Content="保持架 FTF"  IsChecked="{Binding ShowFTF}"  Foreground="#F39C12" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,0,0"/>
                </Grid>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="变工况阶次谱 (Order Spectrum)" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Center"/>
                            <RadioButton Grid.Column="1" Content="全局视图" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                         GroupName="OrderViewMode"
                                         IsChecked="{Binding UseAdaptiveOrderView, Converter={StaticResource InverseBoolConverter}}"/>
                            <RadioButton Grid.Column="2" Content="动态自适应故障频带" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                         GroupName="OrderViewMode"
                                         IsChecked="{Binding UseAdaptiveOrderView}"/>
                        </Grid>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="OrderPlot" Margin="0,5,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="包络谱解调分析 (Envelope Spectrum)" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Center"/>
                            <RadioButton Grid.Column="1" Content="全局视图" FontSize="12" Margin="16,0,0,0" VerticalAlignment="Center"
                                         GroupName="EnvViewMode"
                                         IsChecked="{Binding UseAdaptiveEnvView, Converter={StaticResource InverseBoolConverter}}"/>
                            <RadioButton Grid.Column="2" Content="动态自适应故障频带" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"
                                         GroupName="EnvViewMode"
                                         IsChecked="{Binding UseAdaptiveEnvView}"/>
                        </Grid>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="EnvPlot" Margin="0,5,0,0" />
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Column="2" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="■ 数据驱动分支 (深度特征提取)" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" Margin="5,0,0,10"/>

                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="18"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="CWT 连续小波时频热力图" FontSize="14" FontWeight="Bold" Foreground="#636E72" Margin="0,0,0,5"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBlock Text="16k" FontSize="10" Foreground="#999" VerticalAlignment="Top" HorizontalAlignment="Center"/>
                                <TextBlock Text="0" FontSize="10" Foreground="#999" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
                            </Grid>
                            <Image Grid.Column="1" x:Name="CwtHeatmapImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="时间 (s)" FontSize="10" Foreground="#999" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>


                        <Grid Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock Text="深度学习网络预测概率" FontSize="12" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                            <ScottPlot:WpfPlot Name="SoftMaxProbabiltyBar" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>