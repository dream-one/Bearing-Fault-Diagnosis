<UserControl x:Class="BearingFaultDiagnosis.Views.Pages.DeepDiagnosisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:BearingFaultDiagnosis.Views.Pages"
             xmlns:converters="clr-namespace:BearingFaultDiagnosis.Converters"
             xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
             mc:Ignorable="d"
             d:DesignHeight="900" d:DesignWidth="1600"
             Background="#F5F6FA">
    <UserControl.Resources>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="15"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>

            <!-- ========== 上方：多源传感器实时信号监测 ========== -->
            <Border Grid.Row="0" Grid.ColumnSpan="3" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                <Border.Effect>
                    <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="多源传感器实时信号监测" FontSize="14" FontWeight="Bold" Foreground="#636E72" VerticalAlignment="Top"/>
                    <ScottPlot:WpfPlot Grid.Row="1" x:Name="VibrationPlot" Margin="0,5,0,5" />
                    <ScottPlot:WpfPlot Grid.Row="2" x:Name="CurrentTiltPlot" Margin="0,5,0,0" />
                </Grid>
            </Border>

            <!-- ========== 下方：算法监测卡片区（2x2） ========== -->
            <Grid Grid.Column="0" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <!-- 行1：标题区（继承原布局的行高） -->
                <Grid Margin="5,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="■ 算法诊断监测" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" VerticalAlignment="Center"/>
                </Grid>

                <!-- 卡片1：螺栓松动监测（左上） -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="螺栓松动监测 (倾角漂移分析)" FontSize="14" FontWeight="Bold" Foreground="#636E72"/>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="BoltMonitorPlot" Margin="0,5,0,5" />
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：漂移量 + 漂移速率（保持现有） -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="当前漂移量: " FontSize="12" Foreground="#888"/>
                                <TextBlock Text="{Binding CurrentDrift}" FontSize="12" Foreground="#E74C3C" FontWeight="Bold"/>
                                <TextBlock Text="  漂移速率: " FontSize="12" Foreground="#888" Margin="12,0,0,0"/>
                                <TextBlock Text="{Binding DriftRate}" FontSize="12" Foreground="#F39C12" FontWeight="Bold"/>
                            </StackPanel>

                            <!-- 第二行：算法状态信息 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                <TextBlock Text="状态: " FontSize="11" Foreground="#888"/>
                                <TextBlock Text="{Binding BoltAlarmText}" FontSize="11" Foreground="{Binding BoltAlarmColor}" FontWeight="Bold"/>
                                <TextBlock Text="  θ_DC: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BoltTiltText}" FontSize="11" Foreground="#8E44AD"/>
                                <TextBlock Text="  基线: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BoltBaselineText}" FontSize="11" Foreground="#636E72"/>
                                <TextBlock Text="  温补: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BoltTempCompText}" FontSize="11" Foreground="#1ABC9C"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 卡片3：风口堵塞预警（左下） -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="风口堵塞预警 (电流RMS偏差)" FontSize="14" FontWeight="Bold" Foreground="#636E72"/>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="BlockageMonitorPlot" Margin="0,5,0,5" />
                        <!-- 底部信息区 -->
                        <Grid Grid.Row="2" Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- 第一行：进度条 -->
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding ExceedDurationText}" FontSize="12" Foreground="#888" VerticalAlignment="Center"/>
                                <ProgressBar Grid.Column="1" Margin="8,0,0,0" Height="18"
                                             Minimum="0" Maximum="{Binding ExceedDurationMax}"
                                             Value="{Binding ExceedDurationValue}"
                                             Foreground="{Binding ExceedDurationColor}"
                                             Background="#EEE"/>
                            </Grid>

                            <!-- 第二行：算法状态信息 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                <TextBlock Text="状态: " FontSize="11" Foreground="#888"/>
                                <TextBlock Text="{Binding BlockageAlarmText}" FontSize="11" Foreground="{Binding BlockageAlarmColor}" FontWeight="Bold"/>
                                <TextBlock Text="  RMS: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BlockageRmsText}" FontSize="11" Foreground="#3498DB"/>
                                <TextBlock Text="  ΔI: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BlockageDeltaIText}" FontSize="11" Foreground="#E67E22" FontWeight="Bold"/>
                                <TextBlock Text="  基线: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BlockageBaselineText}" FontSize="11" Foreground="#636E72"/>
                                <TextBlock Text="  连续: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BlockageConsecutiveText}" FontSize="11" Foreground="#E74C3C"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- 右侧列 -->
            <Grid Grid.Column="2" Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="■ 特征分析与补偿" FontSize="16" FontWeight="SemiBold" Foreground="#2D3436" Margin="5,0,0,10"/>

                <!-- 卡片2：叶片不平衡监测（右上） -->
                <Border Grid.Row="1" Background="White" CornerRadius="8" Margin="0,0,0,10" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="叶片不平衡监测 (振动频谱特征)" FontSize="14" FontWeight="Bold" Foreground="#636E72"/>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="BladeMonitorPlot" Margin="0,5,0,5" />
                        <Grid Grid.Row="2" Margin="0,4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <!-- 第一行: 特征值 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="1×fr A1: " FontSize="12" Foreground="#888"/>
                                <TextBlock Text="{Binding Amp1Fr}" FontSize="12" Foreground="#3498DB" FontWeight="Bold"/>
                                <TextBlock Text="  R21: " FontSize="12" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding HarmonicRatio}" FontSize="12" Foreground="#27AE60" FontWeight="Bold"/>
                                <TextBlock Text="  σφ: " FontSize="12" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding PhaseStability}" FontSize="12" Foreground="#F39C12" FontWeight="Bold"/>
                            </StackPanel>
                            <!-- 第二行: 算法状态信息 -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0">
                                <TextBlock Text="状态: " FontSize="11" Foreground="#888"/>
                                <TextBlock Text="{Binding BladeAlarmText}" FontSize="11" Foreground="{Binding BladeAlarmColor}" FontWeight="Bold"/>
                                <TextBlock Text="  EWMA: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding EwmaAmplitude}" FontSize="11" Foreground="#27AE60"/>
                                <TextBlock Text="  基线: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding BaselineStatus}" FontSize="11" Foreground="#636E72"/>
                                <TextBlock Text="  连续: " FontSize="11" Foreground="#888" Margin="8,0,0,0"/>
                                <TextBlock Text="{Binding ConsecutiveText}" FontSize="11" Foreground="#E74C3C"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- 卡片4：辅助验证与环境补偿（右下） -->
                <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="10">
                    <Border.Effect>
                        <DropShadowEffect Color="#DDDDDD" BlurRadius="5" ShadowDepth="1" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="辅助验证与环境补偿" FontSize="14" FontWeight="Bold" Foreground="#636E72"/>
                        <ScottPlot:WpfPlot Grid.Row="1" x:Name="AuxMonitorPlot" Margin="0,5,0,5" />
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                            <TextBlock Text="环境温度: " FontSize="12" Foreground="#888"/>
                            <TextBlock Text="{Binding AmbientTemp}" FontSize="12" Foreground="#888"/>
                            <TextBlock Text="  温度补偿: " FontSize="12" Foreground="#888" Margin="12,0,0,0"/>
                            <TextBlock Text="{Binding TempCompStatus}" FontSize="12" Foreground="#27AE60" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
