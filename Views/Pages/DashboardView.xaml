<UserControl x:Class="BearingFaultDiagnosis.Views.Pages.DashboardView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:scottplot="http://schemas.scottplot.net/2008/xaml/presentation"

      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:BearingFaultDiagnosis.Views.Pages"
        xmlns:collections="clr-namespace:BearingFaultDiagnosis.Models"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
      
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      >
    <UserControl.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#cbd5e1" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <TextBlock Text="实时监控看板" FontSize="24" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ReadDataCommand}" Content="📂 读取数据" 
                       Width="140" Height="42" Margin="0,0,12,0"
                       Background="#8B5CF6" Foreground="White" BorderThickness="0" 
                       FontSize="15" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <ToggleButton Command="{Binding ToggleSaveCommand}" Content="💾 数据落盘保存" 
                             Width="140" Height="42" Margin="0,0,20,0" 
                             Background="#E2E8F0" Foreground="#334155" FontSize="14" FontWeight="SemiBold">
                    <ToggleButton.Style>
                        <Style TargetType="ToggleButton">
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Background" Value="#3B82F6"/>
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Content" Value="💾 正在保存数据..."/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>

                <Button Command="{Binding StopServerCommand}" Content="⏹ 停止监听" 
                       Width="120" Height="42" Margin="0,0,12,0"
                       Background="#FEE2E2" Foreground="#EF4444" BorderThickness="0" 
                       FontSize="15" FontWeight="Bold"/>

                <Button Command="{Binding StartServerCommand}" Content="▶ 开始监听" 
                       Width="120" Height="42" 
                       Background="#10B981" Foreground="White" BorderThickness="0" 
                       FontSize="15" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="5" Height="120">
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" BorderBrush="#3B82F6" BorderThickness="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="设备温度" Foreground="#64748B" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CurrentSensorData.Temperature, StringFormat={}{0:F1}, FallbackValue=25.4}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" ℃" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" BorderBrush="#10B981" BorderThickness="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="运行电流" Foreground="#64748B" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CurrentSensorData.Current, StringFormat={}{0:F2}, FallbackValue=5.20}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" A" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" BorderBrush="#F59E0B" BorderThickness="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="环境湿度" Foreground="#64748B" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CurrentSensorData.Humidity, StringFormat={}{0:F1}, FallbackValue=45.0}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" %" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" Margin="0,0,16,0" BorderBrush="#8B5CF6" BorderThickness="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="横滚角 (Roll)" Foreground="#64748B" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CurrentSensorData.Roll, StringFormat={}{0:F2}, FallbackValue=1.05}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" °" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource CardStyle}" BorderBrush="#EC4899" BorderThickness="0,4,0,0">
                        <StackPanel>
                            <TextBlock Text="俯仰角 (Pitch)" Foreground="#64748B" FontSize="14"/>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding CurrentSensorData.Pitch, StringFormat={}{0:F2}, FallbackValue=-0.32}" FontSize="36" FontWeight="Bold" Foreground="#0F172A"/>
                                <TextBlock Text=" °" FontSize="16" Foreground="#94A3B8" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,20,0,0">
                    <Grid>
                        <scottplot:WpfPlot Name="WpfPlot1" Grid.Row="1" Margin="10"/>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="系统实时日志" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>
                    <Rectangle Grid.Row="1" Height="1" Fill="#E2E8F0" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="2" ItemsSource="{Binding DisplayList}"
                            x:Name="dataListLog"
                            BorderThickness="0" Background="Transparent"
                            VirtualizingStackPanel.IsVirtualizing="True"
                            VirtualizingStackPanel.VirtualizationMode="Recycling"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Focusable" Value="False"/>
                                <Setter Property="IsHitTestVisible" Value="False"/>
                                <Setter Property="Padding" Value="0,4"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.Resources>
                            <DataTemplate DataType="{x:Type sys:String}">
                                <TextBlock Style="{StaticResource LogTextStyle}">
                                   <Run Text="[系统] " Foreground="#94A3B8"/>
                                   <Run Text="{Binding .}" Foreground="#475569"/>
                                </TextBlock>
                            </DataTemplate>

                            <DataTemplate DataType="{x:Type collections:SensorDisplayItem}">
                                <TextBlock Style="{StaticResource LogTextStyle}">
                                   <Run Text="[" Foreground="#94A3B8"/>
                                   <Run Text="{Binding Time}" Foreground="#3B82F6"/>
                                   <Run Text="]" Foreground="#94A3B8"/>
                                   <Run Text=" 数据帧 |" Foreground="#475569"/>
                                   <Run Text=" 温度:" Foreground="#64748B"/>
                                   <Run Text="{Binding Temperature, StringFormat={}{0:F1}}" Foreground="#0F172A"/>
                                   <Run Text=" 湿度:" Foreground="#64748B"/>
                                   <Run Text="{Binding Humidity, StringFormat={}{0:F1}}" Foreground="#0F172A"/>
                                   <Run Text=" CntQ:" Foreground="#64748B"/>
                                   <Run Text="{Binding CountQ}" Foreground="#0F172A"/>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.Resources>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
