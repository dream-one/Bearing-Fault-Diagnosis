<Window x:Class="BearingFaultDiagnosis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BearingFaultDiagnosis"
        xmlns:vm="clr-namespace:BearingFaultDiagnosis.ViewModels"
        xmlns:views="clr-namespace:BearingFaultDiagnosis.Views.Pages"
        mc:Ignorable="d"
        
        Title="轴承故障诊断系统" Height="1080" Width="1920"
      Background="#F1F5F9">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeepDiagnosisViewModel}">
            <views:DeepDiagnosisView />
        </DataTemplate>

        <!-- 新增：页面切换动画样式 -->
        <Style x:Key="PageTransitionStyle" TargetType="ContentControl">
            <Setter Property="Opacity" Value="1"/>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" 
                                             Duration="0:0:0.3"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A" Width="240">
            <DockPanel>
                <!-- 顶部 Logo 与 标题区域 -->
                <StackPanel DockPanel.Dock="Top" Margin="24,32,24,32">
                    <Grid Width="40" Height="40" HorizontalAlignment="Left" Margin="0,0,0,12">
                        <Border Background="#38BDF8" CornerRadius="8" Opacity="0.2"/>
                        <TextBlock Text="⚙" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24"/>
                    </Grid>
                    <TextBlock Text="BearingDiag" Foreground="White" FontSize="22" FontWeight="Bold"/>
                    <TextBlock Text="Fault Diagnosis System" Foreground="#94A3B8" FontSize="12" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- 底部 用户信息区域 (可选) -->
                <Border DockPanel.Dock="Bottom" Margin="12,24,12,24" Padding="12" Background="#1E293B" CornerRadius="8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="32" Height="32" CornerRadius="16" Background="#38BDF8">
                            <TextBlock Text="U" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Admin User" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="System Manager" Foreground="#94A3B8" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 导航菜单区域 -->
                <ListBox ItemsSource="{Binding NavigationItems}"
                         SelectedItem="{Binding SelectedNavItem}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <!-- 增加圆角 Margin 和 Padding，实现悬浮卡片感 -->
                                        <Border x:Name="BgBorder" Background="Transparent" CornerRadius="8" Margin="12,4">
                                            <Grid x:Name="NavGrid" Cursor="Hand" Height="44">
                                                <!-- 圆角指示条 -->
                                                <Border x:Name="ActiveIndicator" 
                                                        HorizontalAlignment="Left" 
                                                        Width="4" Height="20" 
                                                        CornerRadius="2"
                                                        Background="#38BDF8" 
                                                        Visibility="Collapsed"/>

                                                <!-- 调整内容边距以适应新的布局 -->
                                                <ContentPresenter Margin="16,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="BgBorder" Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible"/>
                                                <Setter TargetName="BgBorder" Property="Background" Value="#1E293B"/>
                                                <Setter Property="Foreground" Value="#38BDF8"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="False">
                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- 图标占位，如果你在 ViewModel 增加了 Icon 属性，可以绑定到 Text="{Binding Icon}" -->
                                <TextBlock Grid.Column="0" Text="❖" FontSize="16" Margin="0,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="0">
            <ContentControl Grid.Column="1" 
                        Content="{Binding CurrentViewModel}" 
                        Style="{StaticResource PageTransitionStyle}"/>
        </Grid>
    </Grid>
</Window>