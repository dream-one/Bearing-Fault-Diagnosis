<Window x:Class="BearingFaultDiagnosis.Views.Windows.LoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BearingFaultDiagnosis.Views.Pages"
             mc:Ignorable="d" 
             WindowStartupLocation="CenterScreen"
           
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <!-- 可选背景色，使卡片更突出 -->
        <Grid Background="#F5F5F5">
            <!-- 登录卡片 -->
            <Border Width="400"
                    Padding="30"
                    Background="White"
                    CornerRadius="10"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15" 
                                      ShadowDepth="3" 
                                      Color="#30000000"/>
                </Border.Effect>
                <StackPanel>
                    <!-- 标题 -->
                    <TextBlock Text="登录"
                               FontSize="28"
                               FontWeight="Light"
                               Foreground="#333"
                               Margin="0,0,0,20"/>

                    <!-- 用户名 -->
                    <TextBlock Text="用户名"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <TextBox Height="40"
                             Padding="10,5"
                             BorderBrush="#DDD"
                             Text="{Binding UserName,Mode=TwoWay}"
                             BorderThickness="1"
                             FontSize="14"
                             Margin="0,0,0,15"/>

                    <!-- 密码 -->
                    <TextBlock Text="密码"
                               FontSize="14"
                               Foreground="#666"
                               Margin="0,0,0,5"/>
                    <PasswordBox Height="40"
                                 Padding="10,5"
                                 Password="123456"
                                 BorderBrush="#DDD"
                                 BorderThickness="1"
                                 x:Name="MyPwdBox"
                                 FontSize="14"
                                 Margin="0,0,0,25"/>

                    <!-- 登录按钮 -->
                    <Button Content="登录"
                            Height="45"
                            Background="#1976D2"
                            Foreground="White"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Command="{Binding LoginCommand}"
                            CommandParameter="{Binding ElementName=MyPwdBox}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <!-- 可选按钮悬停效果 -->
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1976D2"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1565C0"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- 注册链接（可根据需要保留或删除） -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="还没有账号？"
                                   Foreground="#999"
                                   FontSize="13"/>
                        <TextBlock Text=" 注册"
                                   Foreground="#1976D2"
                                   FontSize="13"
                                   Cursor="Hand">
                            <TextBlock.TextDecorations>
                                <TextDecoration/>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>